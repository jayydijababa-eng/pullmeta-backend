# YouTube Data API v3 Key (Server-only, never expose to client)
YOUTUBE_API_KEY=

# Allowed CORS Origins (comma-separated, e.g. https://pullmeta.vercel.app,http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000

# Optional: Upstash Redis for distributed rate limiting across Vercel serverless functions
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
