# ==============================================================================
# PullMeta Backend - Environment Variables Configuration
# ==============================================================================

# [Mandatory / Core] YouTube Data API v3 Key
# Used for video metadata extraction on POST /api/extract
# (If omitted, backend automatically falls back to free public oEmbed)
YOUTUBE_API_KEY=

# [Mandatory for Frontend Access] CORS Allowed Origins
# Comma-separated domains permitted to call this API (e.g. your Vercel frontend)
ALLOWED_ORIGIN=https://pullmeta.vercel.app,http://localhost:3000

# [Optional] Upstash Redis for Distributed Rate Limiting
# If empty, backend defaults to high-performance in-memory sliding-window rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [Optional / Docker & Railway Tuning]
# Max download file size in bytes (Default in Dockerfile: 5368709120 = 5 GB)
MAX_FILE_SIZE_BYTES=5368709120

# Max download execution timeout in ms (Default in Dockerfile: 600000 = 10 minutes)
DOWNLOAD_TIMEOUT_MS=600000

# Max concurrent active yt-dlp download processes (Default: 5)
MAX_CONCURRENT_DOWNLOADS=5

# [Optional / Cloud Anti-Bot Bypass]
# YouTube regularly challenges datacenter IPs (Railway, Render, AWS, GCP, etc.)
# If you encounter 429 or "Sign in to confirm you're not a bot", use these:
#
# 1. Netscape-format cookies (raw string or base64:...):
# YOUTUBE_COOKIES=base64:ZXhhbXBsZWNvb2tpZQ==
#
# 2. HTTP/SOCKS5 Proxy:
# YOUTUBE_PROXY=http://user:pass@proxy.example.com:8080
#
# [Optional] Custom Binary Paths (Auto-resolved from system PATH in Docker)
YT_DLP_PATH=
FFMPEG_PATH=
