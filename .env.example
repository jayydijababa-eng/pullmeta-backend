# PullMeta Backend - Environment Configuration Template
# Configure these variables in Railway under the "Variables" tab
# NEVER commit your actual cookies or private secrets to version control!

# ==============================================================================
# YouTube Authentication & Anti-Bot Protection
# ==============================================================================
# Paste your YouTube cookies either in standard Netscape format or JSON array export.
# Obtain cookies from a dedicated non-primary Google account using an incognito window.
YOUTUBE_COOKIES=

# Optional residential or datacenter proxy (HTTP/HTTPS/SOCKS5)
# Example: http://username:password@proxy.example.com:8080
PROXY_URL=

# Optional yt-dlp player client override. LEAVE EMPTY (recommended) so yt-dlp picks its own defaults.
# Do NOT use android, ios or mweb: they require a PO token and cause "HTTP Error 403: Forbidden".
# Safe examples: tv,web_safari  |  android_vr,web_embedded
YOUTUBE_PLAYER_CLIENT=

# Auto-update yt-dlp in the background at server start (default: true in production)
YT_DLP_AUTO_UPDATE=true

# ==============================================================================
# 1,000+ Concurrent Users: Distributed Queue (Redis + BullMQ)
# ==============================================================================
# When REDIS_URL is provided, PullMeta automatically switches from the in-memory
# queue to the distributed BullMQ queue. This allows running stateless web servers
# and multiple worker containers simultaneously without cross-talk or lock conflicts.
# On Railway, simply add a Redis service and link the REDIS_URL variable!
REDIS_URL=
# Concurrency per worker container (2-3 recommended per 1GB-2GB RAM container)
WORKER_CONCURRENCY=2

# ==============================================================================
# 1,000+ Concurrent Users: Cloud Object Storage (Cloudflare R2 / AWS S3)
# ==============================================================================
# Offload finished downloads directly to edge object storage.
# RECOMMENDED: Cloudflare R2 provides S3-compatible API with ZERO ($0) EGRESS FEES!
# (Standard AWS S3 costs $0.09/GB egress, which gets expensive at scale).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pullmeta-downloads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: Cloudflare R2 custom domain or CDN public URL (e.g., https://downloads.pullmeta.com)
S3_PUBLIC_DOMAIN=
# Optional: Set to true for MinIO or self-hosted S3
S3_FORCE_PATH_STYLE=false

# ==============================================================================
# Server & Runtime Configuration
# ==============================================================================
PORT=4000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Download Limits & Concurrency (2-3 concurrent jobs recommended for yt-dlp)
MAX_FILE_SIZE_BYTES=5368709120
DOWNLOAD_TIMEOUT_MS=600000
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=1000
RATE_LIMIT_DOWNLOAD_MAX=20
RATE_LIMIT_EXTRACT_MAX=30
YT_DLP_SLEEP_REQUESTS=1.5

# Disk Cache Settings (for local fallback mode)
FILE_CACHE_TTL_MS=3600000
MAX_FILE_CACHE_BYTES=3221225472
