# PullMeta Backend - Environment Configuration Template
# Configure these variables in Railway under Variables tab
# NEVER commit your actual cookies or private secrets to version control!

# ==============================================================================
# YouTube Authentication & Anti-Bot Protection
# ==============================================================================
# Paste your YouTube cookies either in standard Netscape format or JSON array export.
# Obtain cookies from a dedicated non-primary Google account using an incognito window.
YOUTUBE_COOKIES=

# Optional residential or datacenter proxy (HTTP/HTTPS/SOCKS5)
# Example: http://username:password@proxy.example.com:8080
PROXY_URL=

# Optional yt-dlp player client override. LEAVE EMPTY (recommended) so yt-dlp picks its own defaults.
# Do NOT use android, ios or mweb: they require a PO token and cause "HTTP Error 403: Forbidden".
# Safe examples: tv,web_safari  |  android_vr,web_embedded
YOUTUBE_PLAYER_CLIENT=

# Auto-update yt-dlp in the background at server start (default: true in production)
YT_DLP_AUTO_UPDATE=true

# ==============================================================================
# Server & Runtime Configuration
# ==============================================================================
PORT=4000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Download Limits & Concurrency (2-3 concurrent jobs recommended for yt-dlp)
MAX_FILE_SIZE_BYTES=5368709120
DOWNLOAD_TIMEOUT_MS=600000
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=200
RATE_LIMIT_DOWNLOAD_MAX=20
RATE_LIMIT_EXTRACT_MAX=30
YT_DLP_SLEEP_REQUESTS=1.5

# Disk Cache Settings (for finished downloads & request deduplication)
FILE_CACHE_TTL_MS=3600000
MAX_FILE_CACHE_BYTES=3221225472
